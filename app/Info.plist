<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>CFBundleName</key><string>snapsift</string>
  <key>CFBundleDisplayName</key><string>snapsift</string>
  <key>CFBundleIdentifier</key><string>net.cver.snapsift</string>
  <key>CFBundleExecutable</key><string>SnapsiftApp</string>
  <key>CFBundlePackageType</key><string>APPL</string>
  <key>CFBundleShortVersionString</key><string>0.9.1</string>
  <key>CFBundleVersion</key><string>10</string>
  <key>LSMinimumSystemVersion</key><string>14.0</string>
  <key>NSHighResolutionCapable</key><true/>
  <key>CFBundleIconFile</key><string>AppIcon</string>
  <key>NSPrincipalClass</key><string>NSApplication</string>
  <!-- Development region + localizations so macOS shows the TCC permission
       prompts in the user's language (InfoPlist.strings live in the .lproj
       folders assembled by scripts/build-app.sh). -->
  <key>CFBundleDevelopmentRegion</key><string>en</string>
  <key>CFBundleLocalizations</key>
  <array>
    <string>en</string>
    <string>ja</string>
    <string>zh-TW</string>
  </array>
  <!-- Required for PhotoKit. snapsift reads your library on-device and never
       sends anything anywhere; deletions go to Recently Deleted (recoverable).
       These English strings are the base; per-language overrides ship in
       InfoPlist.strings. Keep them honest: any photo you review and mark can be
       removed, not only exact duplicates. -->
  <key>NSPhotoLibraryUsageDescription</key>
  <string>snapsift reads your photo library on your Mac to find exact duplicates, burst shots, and look-alike photos so you can decide what to remove. Nothing leaves your device.</string>
  <key>NSPhotoLibraryAddUsageDescription</key>
  <string>snapsift modifies your library only to (1) sort candidates into "Snapsift" review albums so you can decide in your own time — a non-destructive label that leaves photos in place — and (2) when you choose, move photos you have reviewed and marked to Recently Deleted, where they remain recoverable for 30 days.</string>
</dict>
</plist>
